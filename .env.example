# ================================
# Aeon IA — Environment Variables
# Copy to .env.local and configure
# ================================

# AI Provider: "openrouter" | "ollama" | "demo"
# openrouter = Cloud API (fast, requires key)
# ollama     = Self-hosted (sovereign, requires server)
# demo       = Simulated responses (no backend needed)
AI_PROVIDER=demo

# ── OpenRouter Configuration ──
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# ── Ollama Configuration (Self-Hosted AI) ──
# Points to your self-hosted Ollama instance
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# Docker port mapping
PORT=3000
