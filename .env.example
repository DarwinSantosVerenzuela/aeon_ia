# ================================
# Aeon IA — Environment Variables
# Copy to .env.local and configure
# ================================

# AI Provider: "gemini" | "openrouter" | "demo"
# gemini     = Google AI Studio (Gemini API, free tier)
# openrouter = Cloud API via OpenRouter (requires API key)
# demo       = Simulated responses (no backend needed)
AI_PROVIDER=gemini

# ── Gemini Configuration (ACTIVO) ──
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter Configuration (INACTIVO — respaldo) ──
# Get your free key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
